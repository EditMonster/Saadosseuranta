teestä 1. Tuotteiden hinnat ja laatuvaatimukset.\nOsa-aluekohtaiset toimituspaikat ja ohjeet ilmenevät liitteestä 3. Tilaajan toimituspisteet ja kuljetuspäivät.\n\nSopimustuotteita tulee olla saatavilla koko sopimuskauden ajan.\n\nSopimus ei sisällä määräostovelvoitetta eikä tuota Toimittajalle yksinoikeutta myydä sopimuksen kohteena olevia tuotteita Tilaajalle. Tarjouspyyntöasiakirjoissa ilmoitetut hankintamäärät, jotka perustuvat Tilaajan arvioon tarvittavasta hankintamäärästä, eivät ole Tilaajaa sitovia. Hankittavien tuotteiden määrää saattavat lisätä tai vähentää esimerkiksi Tilaajan asiakassopimuksissa tai tuotantotoiminnassa tapahtuvat muutokset."}],"additionalCommodityClassification":[{"itemClassificationCode":{"listName":"cpv","value":"39314000"}}],"mainCommodityClassification":[{"itemClassificationCode":{"listName":"cpv","value":"39222100"}}],"realizedLocation":[{"address":{"country":{"identificationCode":{"listName":"country","value":"FIN"}},"region":{"value":"anyw-cou"}}}]},"id":{"schemeName":"notice-id","value":"f1a1ac2e-c3d2-47ac-8c0d-870845b16024"},"noticeLanguageCode":{"value":"FIN"},"versionID":{"value":"01"},"ublVersionID":{"value":"2.3"},"customizationID":{"value":"eforms-sdk-1.13"},"tenderResult":[{"awardDate":{"value":"2000-01-01Z"}}],"nationalExtension":{"noticeResult":{"settledContracts":[{"id":{"value":"CON-0001"}},{"id":{"value":"CON-0002"}},{"id":{"value":"CON-0003"}},{"id":{"value":"CON-0004"}}]}}},"etsCreator":{"id":"0b1adeb0-4928-43f0-3965-08dbb81564ad","name":"Cloudia Kilpailutus"},"isUIReadOnly":true,"linkedNotices":["387156-2026"],"isDpsCan":false,"isFrameworkAgreement":null,"isFrameworkAgreementCan":false,"hasReferenceToProcedure":null,"originalSdkVersion":"eforms-sdk-1.13","dateCreated":"2026-10-16T07:43:59.0650492Z","dateModified":"2026-10-18T08:05:02.0610394Z"}