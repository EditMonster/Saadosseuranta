{"id":59517,"contractFolderID":"518b7c8c-52a2-42d9-9de4-76e5851fcca7","noticeNumber":"2026-059517","eFormsId":"40675a95-ac6c-4a60-abe1-4b61ce4807eb","procedureId":38230,"hideFromOrganisationUsersWhileDraft":false,"datePublished":"2026-10-16T02:05:02.0544259Z","hilmaState":3,"hilmaErrorState":0,"tedState":5,"tedPublicationId":"717314-2026","esentoolNotice":{"id":"40675a95-ac6c-4a60-abe1-4b61ce4807eb","versionId":"01","procedureId":"518b7c8c-52a2-42d9-9de4-76e5851fcca7","status":"PUBLISHED","updatedAt":"2026-10-16T02:02:50+00:00","submittedAt":"2026-10-14T13:21:37+00:00","publicationId":"717314-2026","publicationDate":"2026-10-16T00:00:00+00:00","noticeType":"29","legalBasis":"32014L0024","languages":["FIN"]},"eForm":{"regulatoryDomain":[{"value":"32014L0024"}],"noticeTypeCode":{"listName":"result","value":"can-standard"},"contractFolderID":{"value":"518b7c8c-52a2-42d9-9de4-76e5851fcca7"},"issueDate":{"value":"2026-10-14+03:00"},"issueTime":{"value":"16:21:37+03:00"},"procurementProjectLot":[{"procurementProject":{"name":[{"languageID":"FIN","value":"HUS 028-2026 Käsihuuhteet"}],"id":{"value":"HUS 028-2026"},"procurementTypeCode":{"listName":"contract-nature","value":"supplies"},"description":[{"languageID":"FIN","value":"HUS-yhtymä pyytää tarjouksia etanolipohjaisista käsihuuhteista. Tuotteet on tarkemmin kuvattu jäljempänä tarjouspyynnössä sekä tarjouspyynnön liitteessä 1 Tuoteliite.\n\nKyseessä on kokonaishankinta, eli hankintaa ei ole jaettu osiin. Sopimustoimittajia valitaan kolme. Hankinnan toteuttamisessa käytetään sähköistä huutokauppaa. \n\nSopimuskaudella voidaan lisäksi hankkia hankinnan ennakoidun arvon mukaisesti sopimuksen kohteena oleviin tuoteryhmiin kuuluvia tuotteita, joita ei ole yksilöity tuoteliitteessä (ks. sopimusluonnos).\n\nSopimuskausi on 2 vuotta, jonka jälkeen sopimukset jatkuvat toistaiseksi voimassa olevina. Hinnat ovat kiinteät varsinaisen sopimuskauden (2 vuotta) ajan.\n\nKyseessä on useamman hankintayksikön yhteishankinta, joka toteutetaan hankintarenkaana. Tässä tarjouspyynnössä pyydettyjä tuotteita tulevat käyttämään: HUS-yhtymä (HUS), Etelä-Karjalan hyvinvointialue, Kymenlaakson hyvinvointialue, Päijät-Hämeen hyvinvointialue, Helsingin kaupunki, Itä-Uudenmaan hyvinvointialue, Keski-Uudenmaan hyvinvointialue, Vantaan ja Keravan hyvinvointialue, Länsi-Uudenmaan hyvinvointialue ja Puolustusvoimat. Ks. tarkemmat tiedot tarjouspyynnön liitteessä 2 Sopimusluonnos.\n\nHUS arvioi tarjouspyynnön julkaisuhetkellä ostohistorian perusteella, että hankinnan yhteenlaskettu hankinta-arvo laskettuna 4 vuodelle olisi noin 2,1- 2,4 miljoonaa euroa alv 0%, sisältäen kaikki hankinnassa mukana olevat hankintayksiköt. Kyse on arviosta, eikä hankintayksikkö sitoudu ilmoitettuihin euromääriin ja tarjouspyynnössä ilmoitettuihin, toteutuneisiin kulutusmääriin. Lopulliset tilausmäärät voivat olla ilmoitettua suurempia tai pienempiä. \n\nSuurin osa tuotteista on ns. läpivirtaustuotteita, jotka tilataan HUSin tilausjärjestelmästä, toimitetaan HUSin keskusvarastoon Uutistielle Vantaalle, ja jaetaan HUSin keskusvaraston kautta HUSin, Kymenlaakson, Helsingin kaupungin, Keski-Uusimaan, Vantaan ja Keravan, Itä-Uusimaan sekä Puolustusvoimien toimipisteisiin.\n\nPäijät-Hämeen, Etelä-Karjalan, sekä Länsi-Uudenmaan hyvinvointialueet tekevät tilauksensa omasta tilausjärjestelmästään käsin, ja tuotteet myös toimitetaan heidän ilmoittamiinsa toimitusosoitteisiin. HUS arvioi, että edellä ilmoitetusta hankinnan kokonaisarvosta noin 23 % on Päijät-Hämeen, Etelä-Karjalan tai Länsi-Uudenmaan hyvinvointialueiden tilauksia (sitomaton arvio). \n\nHankinnan kohde ja sitä koskevat vaatimukset on kuvattu yksityiskohtaisesti tarjouspyynnössä ja sen liitteissä.\n\nHankintayksikkö on ennen tarjouspyynnön julkaisua suorittanut hankinnasta markkinakartoituksen julkaisemalla tietopyynnön 24.4.2026 (Ilmoituksen Hilma-numero 2026-047245)."}],"mainCommodityClassification":[{"itemClassificationCode":{"listName":"cpv","value":"33741300"}}],"realizedLocation":[{"address":{"country":{"identificationCode":{"listName":"country","value":"FIN"}},"region":{"value":"anyw-cou"}}}],"plannedPeriod":{"durationMeasure":{"unitCode":"MONTH","value":48.0},"startDate":{"value":"2027-04-01+03:00"}}},"id":{"schemeName":"Lot","value":"LOT-0000"},"procurementIdentifier":"QQ/26/038230/000","tenderingProcess":{"governmentAgreementConstraintIndicator":{"value":true},"auctionTerms":{"auctionConstraintIndicator":{"value":true}},"contractingSystem":[{"contractingSystemTypeCode":{"listName":"dps-usage","value":"none"}},{"contractingSystemTypeCode":{"listName":"framework-agreement","value":"none"}}]},"tenderingTerms":{"ublExtensions":[{"extensionContent":{"eformsExtension":{"strategicProcurement":[{"applicableLegalBasis":{"listName":"cvd-scope","value":"false"}}]}}}],"fundingProgramCode":{"listName":"eu-funded","value":"no-eu-funds"}}}],"contractingParty":[{"contractingActivity":[{"activityTypeCode":{"listName":"authority-activity","value":"health"}}],"contractingPartyType":[{"partyTypeCode":{"listName":"buyer-legal-type","value":"ra"}}],"party":{"partyIdentification":[{"id":{"schemeName":"organization","value":"ORG-0002"}}],"serviceProviderParty":[{"serviceTypeCode":{"listName":"organisation-role","value":"ted-esen"},"party":{"partyIdentification":[{"id":{"schemeName":"organization","value":"ORG-0012"}}]}}]}},{"contractingActivity":[{"activityTypeCode":{"listName":"authority-activity","value":"gen-pub"}}],"contractingPartyType":[{"partyTypeCode":{"listName":"buyer-legal-type","value":"la"}}],"party":{"partyIdentification":[{"id":{"schemeName":"organization","value":"ORG-0003"}}],"serviceProviderParty":[{"serviceTypeCode":{"listName":"organisation-role","value":"ted-esen"},"party":{"partyIdentification":[{"id":{"schemeName":"organization","value":"ORG-0012"}}]}}]}},{"contractingActivity":[{"activityTypeCode":{"listName":"authority-activity","value":"health"}}],"contractingPartyType":[{"partyTypeCode":{"listName":"buyer-legal-type","value":"ra"}