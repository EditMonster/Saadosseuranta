{"eduskunta":{"kannat":{"esittely":3,"muutoksia":5,"varauksin":4},"luettu":12,"n":12,"rivit":[{"committee":"UaV","date":"2026-10-07","gist":"Samalla katsomme, että kansainvälisen oikeuden velvoitteiden asemaa tulisi vahvistaa edelleen myös itse lakitekstissä. Ulkoministeriön rooli kohdemaan ihmisoikeus- ja riskiarvioinnissa on keskeinen, ja sen arvio tulee ottaa sitovasti huomioon lupapäätöksissä.","org":"Suomen Sadankomitea ry","read":true,"stance":"varauksin","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-52468"},{"committee":"UaV","date":"2026-10-02","gist":"Säännöksessä tulisi tunnistaa, että kotimaisen puolustuskyvyn ylläpito edellyttää myös kilpailukykyistä, kansainvälisesti toimivaa puolustusteollista ja teknologista perustaa.","org":"Puolustus- ja Ilmailuteollisuus PIA ry","person":"Tuija Karanko","read":true,"stance":"varauksin","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-50861"},{"committee":"UaV","date":"2026-10-02","gist":"Hakijoita koskevien vaatimusten osalta kannatamme viennin vastuullisuuden vahvistamista, mutta korostamme vaatimusten riskiperusteisuutta, oikeasuhtaisuutta ja pk-yritysten rajallisten resurssien huomioon ottamista.","org":"Elinkeinoelämän keskusliitto ry","person":"Markku Rajamäki","read":true,"stance":"varauksin","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-50863"},{"committee":"UaV","date":"2026-10-02","gist":"SaferGlobe kannattaa 14 §:n vastaanottajan ja loppukäyttäjän tuntemista koskevaa vaatimusta sekä sisäisen vastuullisuusohjelman mahdollisuutta.","org":"SaferGlobe","person":"Maria Mekri","read":true,"stance":"varauksin","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-50864"},{"committee":"UaV","date":"2026-10-07","gist":"Suomen Punainen Risti on ajankohtaisselonteosta antamassaan lausunnossa korostanut, että Suomen tulee paitsi puolustaa kansainvälistä humanitaarista oikeutta yleisesti, myös vaatia sen noudattamista käytännössä ja toimia konkreettisesti oikeudellisten velvoitteiden …","org":"Suomen Punainen Risti","read":true,"stance":"muutoksia","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-52464"},{"committee":"UaV","date":"2026-10-07","gist":"Jos tälle on olemassa merkittävä riski, viennistä tulisi aina pidättäytyä.","org":"Amnesty International, Suomen osasto ry","read":true,"stance":"muutoksia","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-52466"},{"committee":"UaV","date":"2026-10-07","gist":"Mikäli kuitenkin on niin, että ulkoministeriö on todennut kansainvälisten velvoitteiden edellyttävän vientiluvan epäämistä, valtioneuvoston ei pitäisi päätyä luvan myöntämiseen.","org":"Tampereen yliopisto","person":"Kari Paasonen","read":true,"stance":"muutoksia","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-52473"},{"committee":"UaV","date":"2026-10-02","gist":"Esitämme muotoilumuutosta 9 §:ään Ruotsin mallin mukaisesti: ” Edellä 2 luvussa tarkoitettu lupa voidaan myöntää tai julkaista, jos se on Suomen ulko-, turvallisuus- ja puolustuspoliittisten tavoitteiden mukaista.","org":"Puolustus- ja Ilmailuteollisuus PIA ry","person":"Tuija Karanko","read":true,"stance":"muutoksia","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-50862"},{"committee":"UaV","date":"2026-10-02","gist":"Yleisille vientiluville täsmälliset rajat ja toimiva prosessi kiireelliseen keskeyttämiseen (9 a, 16, 17, 31 ja 32 §). Jatkuva riskinarviointi ja resurssit loppukäytön sekä uusien teknologioiden valvontaan (3, 9, 14, 15 ja 34 §).","org":"SaferGlobe","person":"Maria Mekri","read":true,"stance":"muutoksia","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-50865"},{"committee":"UaV","date":"2026-10-02","gist":"Lain soveltamisalan ulkopuolelle jätettäisiin nimenomaisesti Pohjois-Atlantin puolustusliittoon sekä EU:n sotilasesikuntiin ja -henkilöihin liittyvät Suomea sitovat kansainväliset valtiosopimukset, Suomen ja Yhdysvaltojen välisestä puolustusyhteistyöstä tehty valtiosopimus sekä …","org":"puolustusministeriö","person":"Laura Sinisalo","read":true,"stance":"esittely","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-50858"},{"committee":"UaV","date":"2026-10-02","gist":"Puolustustarvikkeiden viennistä annetun lain päivittäminen Neuvotteleva virkamies Riikka Pitkänen Hallitussihteeri Laura Sinisalo Mikä muuttuu, mikä ei?","org":"puolustusministeriö","person":"Laura Sinisalo","read":true,"stance":"esittely","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-50859"},{"committee":"UaV","date":"2026-10-02","gist":"Ulkoministeriö pitää perusteltuina lain soveltamisalaan ehdotettuja uusia rajauksia muun muassa Nato-jäsenyyden ja Yhdysvaltojen kanssa tehdyn kahdenvälisen puolustusyhteistyösopimuksen johdosta.","org":"ulkoministeriö","person":"Teemu Sepponen","read":true,"stance":"esittely","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-50860"}]},"id":"fi-he-149-2026","kierros":{"kannat":{"ei":1},"luettu":1,"n":21,"rivit":[{"date":"2026-06-04","org":"Suomen Punainen Risti","url":"https://api.hankeikkuna.fi/asiakirjat/d279a23e-9244-4ffe-9e7c-9a0c86b52742/23232106-ecd1-4be6-8b9e-a449dce6dcf9/LAUSUNTO_20260623074953.PDF"},{"date":"2026-05-29","org":"Oikeusministeriö","url":"https://api.hankeikkuna.fi/asiakirjat/d279a23e-9244-4ffe-9e7c-9a0c86b52742/876b0fa3-fa91-427d-9b2a-4e5cd409761f/LAUSUNTO_20260529072212.PDF"},{"date":"2026-05-28","org":"SaferGlobe ry","url":"https://api.hankeikkuna.fi/asiakirjat/d279a23e-9244-4ffe-9e7c-9a0c86b52742/1fb491a8-230c-43dc-a30c-1d5672c8ad8f/LAUSUNTO_20260531090607.PDF"},{"date":"2026-05-27","org":"Insta Group Oy","url":"https://api.hankeikkuna.fi/asiakirjat/d279a23e-9244-4ffe-9e7c-9a0c86b52742/a694b2b9-ff41-4184-9f41-676256890401/LAUSUNTO_20260527073549.PDF"},{"date":"2026-05-27","org":"Työ- ja elinkeinoministeriö","url":"https://api.hankeikkuna.fi/asiakirjat/d279a23e-9244-4ffe-9e7c-9a0c86b52742/6e565361-297a-44ae-9d05-80bf83a58624/LAUSUNTO_20260528054228.PDF"},{"date":"2026-05-27","org":"Finnish Information Security Cluster (FISC) – Kyberala ry","url":"https://api.hankeikkuna.fi/asiakirjat/d279a23e-9244-4ffe-9e7c-9a0c86b52742/cb759760-aa0f-4e10-9027-3