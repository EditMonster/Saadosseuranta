{"eduskunta":{"kannat":{"esittely":2,"kannattaa":2,"kanta":1,"osin":1,"varauksin":8},"luettu":14,"n":14,"rivit":[{"committee":"MmV","date":"2026-09-18","gist":"SLC vastustaa tältä osin ehdotettua muutosta ja katsoo, että tuomioistuimen nykyinen tapauskohtainen harkintavalta tulee säilyttää.","org":"Svenska lantbruksproducenternas centralförbund SLC rf","person":"Cecilia Nyholm","read":true,"stance":"osin","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-44727"},{"committee":"MmV","date":"2026-09-18","gist":"Animalia kannattaa sitä, että eläintenpitokiellon vähimmäiskesto nostetaan perusmuotoisissa teoissa kolmeen vuoteen ja törkeissä tekomuodoissa viiteen vuoteen.","org":"Animalia ry","read":true,"stance":"varauksin","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-44341"},{"committee":"MmV","date":"2026-09-18","gist":"Ruokavirasto toivoo edelleen, kuten lausunnoissaankin, että tuomioistuimella olisi vähintäänkin mahdollisuus varmistaa syyttäjältä, onko syyttäjä jättänyt vaatimatta menettämisseuraamusta tarkoituksella.","org":"Ruokavirasto","read":true,"stance":"varauksin","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-44681"},{"committee":"MmV","date":"2026-09-18","gist":"SEY yhtyy myös hallituksen esityksen perusteluihin, joissa näitä muutoksia perustellaan eläintenpitokiellon vaikuttavuuden lisäämisellä, rikoksen uusimisriskillä sekä eläinten hyvinvoinnin vaarantumisen vähenemisen edellyttämällä riittävän pitkällä turvaamistoimella.","org":"SEY Suomen eläinsuojelu ry","person":"Kati White","read":true,"stance":"varauksin","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-44682"},{"committee":"MmV","date":"2026-09-18","gist":"Kissaliitto pitää perusteltuna, että eläintenpitokielto määrätään aiempaa johdonmukaisemmin, mutta korostaa suhteellisuusperiaatteen ja tapauskohtaisen harkinnan säilyttämisen merkitystä.","org":"Suomen Kissaliitto ry","read":true,"stance":"varauksin","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-44684"},{"committee":"MmV","date":"2026-09-18","gist":"Pidämme hallituksen esitystä kokonaisuutena kannatettavana ja eläinten hyvinvoinnin näkökulmasta tarpeellisena.","org":"Suomen Hippos ry","read":true,"stance":"varauksin","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-44742"},{"committee":"MmV","date":"2026-09-18","gist":"Eläinten hyvinvoinnin ja suojelun parantamiseksi MTK kannattaa nyt esitetyn sijaan Välitä viljelijästä -toiminnan vahvistamista, eläinsuojeluvalvonnan laadun kehittämistä, lajikohtaisen asiantuntemuksen vahvistamista valvonnassa, viranomaisten välisen yhteistyön parantamista …","org":"Maa- ja metsätaloustuottajain Keskusliitto MTK ry","person":"Kimmo Tammi","read":true,"stance":"varauksin","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-44818"},{"committee":"MmV","date":"2026-09-18","gist":"Eläintenpitokiellon määräämisperuste ja kiellon voimassaoloaikojen vähimmäiskesto Suomen Eläinlääkäriliitto kannattaa ehdotusta, että rikoslain 17 luvun 23 §:n 1 momenttia muutettaisiin siten, että perusmuotoiseen eläinsuojelurikokseen syyllistynyt henkilö on määrättävä …","org":"Suomen Eläinlääkäriliitto ry","person":"Veera Kurenlahti","read":true,"stance":"varauksin","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-44819"},{"committee":"MmV","date":"2026-09-18","gist":"SVELL pitää tällaista sääntelyä tarpeellisena myös Suomessa.","org":"Suomen valvontaeläinlääkäriliitto ry","read":true,"stance":"varauksin","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-44821"},{"committee":"MmV","date":"2026-09-18","gist":"Pidämme erityisen kannatettavana sitä, että eläintenpitokiellon määräämisestä perusmuotoisen eläinsuojelurikoksen yhteydessä tehdään nykyistä selkeämmin pääsääntö.","org":"Eläinten hyvinvointikeskus EHK","person":"Tiina Kauppinen","read":true,"stance":"kannattaa","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-44157"},{"committee":"MmV","date":"2026-09-18","gist":"Pidämme hyvänä muutosta eläintenpitokiellon määräämisperusteiden muutoksesta siten, että perusmuotoisen eläinsuojelurikoksen perusteella kielto olisi määrättävä, ellei kiellon määräämättä jättämiselle ole painavia perusteita.","org":"Suomen Kennelliitto ry","read":true,"stance":"kannattaa","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-44822"},{"committee":"MmV","date":"2026-09-18","gist":"Kuten perustuslakivaliokunnan lausunnoissakin todetaan, unionin jäsenvaltiot ovat SEUT 13 artiklan myötä sitoutuneet eläinten hyvinvoinnin vaatimusten täysimääräiseen huomioon ottamiseen unionin lainsäädännön täytäntöönpanossa.","org":"eduskunnan oikeusasiamiehen kanslia","read":true,"stance":"kanta","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-42918"},{"committee":"MmV","date":"2026-09-18","gist":"Ministeriö suhtautuu myönteisesti myös eläintenpitokiellon vähimmäiskeston pidentämiseen.","org":"maa- ja metsätalousministeriö","person":"Tiina Pullola","read":true,"stance":"esittely","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-44740"},{"committee":"MmV","date":"2026-09-18","gist":"Olosuhteiden muuttumisen tulisi olla laadultaan sellaista, ettei vaaraa eläimiin kohdistuvan rikoksen uusimisesta tai eläinten hyvinvoinnin vahingoittamisesta voitaisi enää perustellusti katsoa olevan käsillä.","org":"oikeusministeriö","person":"Erik Inberg","read":true,"stance":"esittely","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-44814"}]},"id":"fi-he-130-2026","kierros":{"kannat":{"ei":2},"luettu":2,"n":67,"rivit":[{"date":"2026-05-19","org":"Maa- ja metsätaloustuottajain Keskusliitto MTK ry","url":"https://api.hankeikkuna.fi/asiakirjat/841eccfe-dd8f-42c0-a9c9-6fe999c73750/563a8c73-c30e-444c-9eb4-ef8e46244465/LAUSUNTO_20260519162716.PDF"},{"date":"2026-05-19","org":"Oikeuspoliittinen yhdistys Demla ry","url":"https://api.hankeikkuna.fi/asiakirjat/841eccfe-dd8f-42c0-a9c9-6fe999c73750/b2cdc451-c5f6-4d51-9cb8-51921f2b15d4/LAUSUNTO_20260519163141.PDF"},{"date":"2026-05-19","org":"Helsingin eläinsuojeluyhdistys HESY ry","url":"https://api.hankeikkuna.fi/asiakirjat/841eccfe-dd8f-42c0-a9c9-6fe999c73750/8bdf7166-4293-42bf-8b6f-8c5f9e