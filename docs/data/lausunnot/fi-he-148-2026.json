{"eduskunta":{"kannat":{"esittely":2,"muutoksia":6,"vastustaa":1},"luettu":9,"n":9,"rivit":[{"committee":"PeV","date":"2026-10-02","gist":"Hallitus katsoo, että lakia voidaan pitää myös nyt ehdotettavan voimassaolon jatkamisen jälkeen rajattuna poikkeuksena perustuslaista.","org":"Anu Mutanen","person":"Anu Mutanen","read":true,"stance":"vastustaa","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-50844"},{"committee":"PeV","date":"2026-10-02","gist":"Esityksen suhdetta perustuslakiin ja säätämisjärjestystä käsittelevässä jaksossa katsotaan, että lakiehdotusta voidaan pitää nyt ehdotettavan voimassaolon jatkamisen jälkeen perustuslain 73 §:n 1 momentissa tarkoitettuna rajattuna poikkeuksena perustuslaista.","org":"Tuomas Ojanen","person":"Tuomas Ojanen","read":true,"stance":"muutoksia","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-50065"},{"committee":"PeV","date":"2026-10-02","gist":"Katson edelleen huolimatta perustuslakivaliokunnan aikaisemmista lausunnoista, että käsiteltävänä olevan lakiehdotuksen perustuslainmukaisuutta ja suhdetta kansainvälisiin ihmisoikeussopimuksiin koskevassa arvioinnissa valtiosääntöoikeudellisena lähtökohtana tulisi olla se …","org":"Veli-Pekka Viljanen","person":"Veli-Pekka Viljanen","read":true,"stance":"muutoksia","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-50109"},{"committee":"PeV","date":"2026-10-02","gist":"Mainitut peruskysymykset vaatisivat mielestäni joka tapauksessa tähänastista enemmän, perusteellisempaa ja kriittisempää ajattelua etenkin ottaen huomioon, minkälaisessa maailmassa ja ympäristössä nykyisin eletään.","org":"Pauliine Koskelo","person":"Pauliine Koskelo","read":true,"stance":"muutoksia","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-50196"},{"committee":"PeV","date":"2026-09-30","gist":"Hallintovaliokunta on päätynyt siihen, että eduskunnan osallistamista koskevaa sääntelyä on voimassa olevaa lakia säädettäessä harkittu tarkoin, ja katsonut, että valittu ratkaisu täyttää ne vaatimukset, joita eduskunnan osallistamiselta voidaan poikkeuksellisen nopeaa …","org":"Oikeuskanslerinvirasto","person":"Janne Salminen","read":true,"stance":"muutoksia","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-48750"},{"committee":"PeV","date":"2026-09-30","gist":"Hallitus esittää edelleen lain voimassaololle kahden vuoden jatkoaikaa.","org":"eduskunnan oikeusasiamiehen kanslia","person":"Jari Råman","read":true,"stance":"muutoksia","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-48753"},{"committee":"PeV","date":"2026-09-30","gist":"Pidän hyvin ongelmallisena ajatusta, että oikeusvaltion tulisi olla valmis luopumaan täysivaltaisuudestaan ja kansallisesta turvallisuudestaan, jos vihamielisen valtion vaikuttamisen välineenä olevien maahantulijoiden oikeuksien täysimääräinen1 toteuttaminen sitä edellyttää.","org":"Petri Jääskeläinen","person":"Petri Jääskeläinen","read":true,"stance":"muutoksia","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-48757"},{"committee":"PeV","date":"2026-09-30","gist":"Suomen täysivaltaisuuden ja kansallisen turvallisuuden varmistaminen vaatii viranomaisten taktisen ja teknisen varautumisen lisäksi sääntelyä, jonka soveltaminen voidaan uhka-arvion niin vaatiessa aloittaa nopeasti.","org":"sisäministeriö","person":"Anne Ihanus","read":true,"stance":"esittely","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-48749"},{"committee":"PeV","date":"2026-09-30","gist":"EIS:n 13 artikla luettuna yhdessä 2 tai 3 artiklan kanssa edellyttää lisäksi maasta poistamisen yhteydessä tehokasta oikeussuojakeinoa ja, kun henkilö esittää perustellun väitteen siitä, että maasta poistaminen loukkaisi hänen 2 tai 3 artiklassa turvattuja oikeuksiaan …","org":"ulkoministeriö","person":"Anu Konttinen","read":true,"stance":"esittely","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-48751"}]},"id":"fi-he-148-2026","kierros":{"kannat":{"ei":1},"luettu":1,"n":28,"rivit":[{"date":"2026-08-21","org":"Eduskunnan oikeusasiamiehen kanslia","url":"https://api.hankeikkuna.fi/asiakirjat/e203cee1-2c0c-4079