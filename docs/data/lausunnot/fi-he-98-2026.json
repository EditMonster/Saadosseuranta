{"eduskunta":{"kannat":{"kannattaa":3,"kanta":1,"muutoksia":6,"osin":2,"varauksin":4},"luettu":16,"n":19,"rivit":[{"committee":"HaV","date":"2026-09-10","gist":"Esityksessä on päädytty muiden etsintöjen osalta hieman matalampaan kynnykseen pääsääntöisesti siksi, ettei näiden keinojen ole katsottu rinnastuvan perusoikeuksiin kohdistuvan puuttumisen tason osalta muihin välttämättömyysedellytystä vaativiin keinoihin (kuten peitetoiminta …","org":"Helsingin käräjäoikeus","person":"Essi Konttinen-Di Nardo","read":true,"stance":"osin","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-42161"},{"committee":"HaV","date":"2026-09-10","gist":"Näillä edellä lausutuilla edellytyksillä Suomen Asianajajat kannattaa ehdotettuja muutoksia.","org":"Suomen Asianajajat","person":"Pekka Ylikoski","read":true,"stance":"osin","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-42360"},{"committee":"HaV","date":"2026-09-04","gist":"Keskusrikospoliisi pitää esitettyjä muutoksia kannatettavina jäljempänä tarkemmin esitetyin perusteluin.","org":"keskusrikospoliisi","read":true,"stance":"varauksin","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-40254"},{"committee":"HaV","date":"2026-09-04","gist":"Näin ollen suojelupoliisi kannattaa hallituksen esitykseen sisältyviä lakiehdotuksia ja pitää erityisesti salaisen etsinnän ja osallistuvan tietolähteen käytön mahdollistavaa sääntelyä tarkoituksenmukaisena.","org":"suojelupoliisi","read":true,"stance":"varauksin","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-40255"},{"committee":"HaV","date":"2026-09-04","gist":"Tulli pitää esitettyjä toimivaltuusmuutoksia ja -lisäyksiä erittäin tarpeellisina ja katsoo niiden lisäävän esitutkintaviranomaisten toimintaedellytyksiä toimia muuttuneessa ja haasteellisessa toimintaympäristössä.","org":"Tulli","person":"Kimmo Kaunisto","read":true,"stance":"varauksin","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-40774"},{"committee":"PeV","date":"2026-06-17","gist":"Toisaalta on ymmärrettävää, että pakkokeinotoimivaltuuksien kokonaistarkastelu edellyttää huolellista ja kattavaa arviointityötä, joka puolestaan edellyttää riittävästi aikaa.","org":"Dan Helenius","person":"Dan Helenius","read":true,"stance":"varauksin","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-36560"},{"committee":"PeV","date":"2026-09-11","gist":"Toisaalta säännös ei näin rajattuna laajentaisi kokonaisuudessaan niiden rikosten joukkoa, joiden kohdalla vangitseminen voisi yleisesti ottaen tulla kyseeseen, mitä voidaan pitää hyväksyttävänä näkökohtana myös oikeasuhtaisuuden vaatimus huomioon ottaen.","org":"Olli Mäenpää","person":"Olli Mäenpää","read":true,"stance":"muutoksia","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-42550"},{"committee":"HaV","date":"2026-09-10","gist":"Korostan tässä yhteydessä kuitenkin sitä, että karttamisvaaraa ja sotkemisvaaraa arvioitaessa odotettavissa olevan vankeusrangaistuksen pituuden tulisi edelleen olla seikka, jonka tuomioistuin voi ottaa huomioon arvioidessaan esimerkiksi epäillyn rikoksentekijän ulkomaille …","org":"eduskunnan oikeusasiamiehen kanslia","person":"Mikko Eteläpää","read":true,"stance":"muutoksia","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-42165"},{"committee":"HaV","date":"2026-09-04","gist":"Poliisihallitus esittää toissijaisesti, että esitys hyväksyttäisiin seuraavalla tavalla muutettuna: 40 c § Osallistuvan tietolähteen käytöstä päättäminen ja yhteensovittaminen ilmoitusvelvollisuus Keskusrikospoliisin päällikkö tai tietolähdetoimintaan määrätty salaiseen …","org":"Poliisihallitus","person":"Anna-Riina Korteniemi","read":true,"stance":"muutoksia","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-40772"},{"committee":"PeV","date":"2026-09-04","gist":"Vaikka esityksessä ehdotetaan lisättäväksi jo käytössä olevaan toimivaltuuteen osallistuvuutta koskeva elementti, ei tämän katsota muuttavan toimivaltuuden luonnetta siten, että osallistuvan tietolähteen toiminta tulisi arvioida perustuslain 124 §:ssä tarkoitetuksi julkiseksi …","org":"Veli-Pekka Viljanen","person":"Veli-Pekka Viljanen","read":true,"stance":"muutoksia","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-40978"},{"committee":"PeV","date":"2026-06-17","gist":"Korostan tässä yhteydessä kuitenkin sitä, että karttamisvaaraa ja sotkemisvaaraa arvioitaessa odotettavissa olevan vankeusrangaistuksen pituuden tulisi edelleen olla seikka, jonka tuomioistuin voi ottaa huomioon arvioidessaan esimerkiksi epäillyn rikoksentekijän ulkomaille …","org":"eduskunnan oikeusasiamiehen kanslia","person":"Jari Råman","read":true,"stance":"muutoksia","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-35423"},{"committee":"PeV","date":"2026-06-17","gist":"Lähtökohtana tulisi nähdäkseni olla, että salaisen etsinnän edellytyksenä tulisi olla sen välttämättömyys myös suhteessa pakkokeinolain 8 luvun mukaisesti toteutettavaan etsintään.","org":"Minna Kimpimäki","person":"Minna Kimpimäki","read":true,"stance":"muutoksia","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-36407"},{"committee":"HaV","date":"2026-09-10","gist":"Syyttäjälaitos pitää kannatettavina myös esityksessä esitettyjä uudistuksia koskien salaisia pakkokeinoja.","org":"Syyttäjälaitos","person":"Heidi Savurinne","read":true,"stance":"kannattaa","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-42160"},{"committee":"HaV","date":"2026-09-04","gist":"Rajavartiolaitos kannattaa hallituksen esitystä eduskunnalle laiksi pakkokeinolain 2 ja 10 luvun muuttamisesta sekä siihen liittyviksi laeiksi esitetyssä muodossa.","org":"Rajavartiolaitos","person":"Markus Paljakka","read":true,"stance":"kannattaa","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-41084"},{"committee":"PeV","date":"2026-06-17","gist":"Kohdan mukaan tuomioistuin saisi vangitsemisvaatimuksen esittämiseen oikeutetun virkamiehen vaatimuksesta määrätä rikoksesta todennäköisin syin epäillyn vangittavaksi, jos rikoksesta ei ole säädetty lievempää rangaistusta kuin kaksi vuotta vankeutta ja epäillyn henkilökohtaisten …","org":"Sakari Melander","person":"Sakari Melander","read":true,"stance":"kannattaa","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-36522"},{"committee":"PeV","date":"2026-06-17","gist":"Yhtä seikkaa lukuun ottamatta en ole havainnut esitykseen sisältyvissä lakiehdotuksia piirteitä, joiden voisi katsoa olevan ristiriidassa EIS-vaatimusten kanssa.","org":"Pauliine Koskelo","person":"Pauliine Koskelo","read":true,"stance":"kanta","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-36078"},{"committee":"HaV","date":"2026-09-04","org":"oikeusministeriö","person":"Joni Korpinen","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-40769"},{"committee":"HaV","date":"2026-09-04","org":"sisäministeriö","person":"Juha Tuovinen","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-40771"},{"committee":"PeV","date":"2026-06-17","org":"oikeusministeriö","person":"Joni Korpinen","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-36519"}]},"id":"fi-he-98-2026","kierros":{"kannat":{"ei":1},"luettu":0,"n":28,"rivit":[{"date":"2026-01-30","org":"Helsingin hallinto-oikeus","url":"https://api.hankeikkuna.fi/asiakirjat/87caf653-43a4-4499-bf33-5ca78e4476c7/56bf36d8-7f60-424e-b5e1-d9511f99d8dc/LAUSUNTO_20260203094433.PDF"},{"date":"2026-01-20","org":"Sanoma Media Finland Oy","url":"https://api.hankeikkuna.fi/asiakirjat/87caf653-43a4-4499-bf33-5ca78e4476c7/42adef81-450e-4145-94eb-02c090198c12/LAUSUNTO_20260120140455.PDF"},{"date":"2026-01-16","org":"YDHV lakitiimi","url":"https://api.hankeikkuna.fi/asiakirjat/87caf653-43a4-4499-bf33-5ca78e4476c7/b14a4753-4b21-4660-8ae4-0ebc00087f9e/LAUSUNTO_20260116111450.PDF"},{"date":"2026-01-16","org":"Keskusrikospoliisi KRP","url":"https://api.hankeikkuna.fi/asiakirjat/87caf653-43a4-4499-bf33-5ca78e4476c7/74051b42-82f9-474a-af9f-64b911d45bc2/LAUSUNTO_20260116134632.PDF"},{"date":"2026-01-16","org":"Poliisihallitus","url":"https://api.hankeikkuna.fi/asiakirjat/87caf653-43a4-4499-bf33-5ca78e4476c7/dc80b9a5-31c3-470a-851d-ee18dfc381ab/LAUSUNTO_20260118034848.PDF"},{"date":"2026-01-16","org":"Elinkeinoelämän keskusliitto EK","