{"eduskunta":{"kannat":{"esittely":1,"kannattaa":1,"kanta":2,"muutoksia":5,"varauksin":1},"luettu":10,"n":10,"rivit":[{"committee":"StV","date":"2026-09-18","gist":"050 586 5677 SOSTE Suomen sosiaali ja terveys ry Vertti Kiukas pääsihteeri SOSTE pitää oikeansuuntaisena esitettyä korjausta epäkohtaan, jossa yleistuen tarveharkinta kohdistuu myös henkilöihin, jotka ovat päättäneet siirtyä osittaiselle varhennetulle vanhuuseläkkeelle ennen …","org":"SOSTE Suomen sosiaali ja terveys ry","read":true,"stance":"varauksin","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-44647"},{"committee":"StV","date":"2026-09-18","gist":"Suomen Ammattiliittojen Keskusjärjestö SAK nostaa esiin, että hallituksen esitys korjaisi toimeentuloa vain osalla varhennetun vanhuuseläkkeen ottaneista.","org":"Suomen Ammattiliittojen Keskusjärjestö SAK ry","read":true,"stance":"muutoksia","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-44637"},{"committee":"StV","date":"2026-09-18","gist":"Eläkeläisliittojen etujärjestö EETU ry:n mukaan esitys on tervetullut parannus yleistukilainsäädännön aiheuttamaan epäkohtaan, joka syntyi yleistuen tarveharkinnan ulottamisesta ositettua varhennettua vanhuuseläkettä (OVE) saaviin.","org":"Eläkeläisliittojen etujärjestö EETU ry","person":"Matti Huutola","read":true,"stance":"muutoksia","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-44703"},{"committee":"StV","date":"2026-09-18","gist":"Keva katsoo, että osittaisen varhennetun vanhuuseläkkeen suojapäivämäärää tulisi myöhentää niin, että sitä ei sovellettaisi ennen 1.5.2026 alkaviin eläkkeisiin.","org":"Keva","person":"Jussi-Pekka Rantanen","read":true,"stance":"muutoksia","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-44782"},{"committee":"StV","date":"2026-09-18","gist":"Kelalla on ollut esityksen valmistelun aikana mahdollisuus esittää arvioita esityksen kohderyhmän koosta ja toimeenpanovaikutuksista.","org":"Kansaneläkelaitos","person":"Antti Ristimäki","read":true,"stance":"muutoksia","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-44784"},{"committee":"StV","date":"2026-09-18","gist":"STTK katsoo, että OVE tulisi rajata pois yleistuen tarveharkinnan piiristä.","org":"STTK ry","read":true,"stance":"muutoksia","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-44850"},{"committee":"StV","date":"2026-09-18","gist":"Akava pitää perusteltuna sitä, että yleistuen käyttöönoton yhteydessä syntyneitä ennakoimattomia vaikutuksia osittaista varhennettua vanhuuseläkettä saaville henkilöille pyritään korjaamaan.","org":"Akava ry","read":true,"stance":"kannattaa","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-45324"},{"committee":"StV","date":"2026-09-18","org":"Elinkeinoelämän keskusliitto ry","read":true,"stance":"kanta","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-44645"},{"committee":"StV","date":"2026-09-18","gist":"Asiantuntijalausunto yleistukilain voimaantulosäännöksen muuttamisesta Eläketurvakeskus ehdottaa myöhennettäväksi päivämäärää (16.1.2026), jota ennen eläkepäätöksen saaneet suojattaisiin tarveharkinnalta.","org":"Eläketurvakeskus","person":"Marjukka Hietaniemi","read":true,"stance":"kanta","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-44823"},{"committee":"StV","date":"2026-09-18","gist":"Ehdotettu laki on tarkoitettu tulemaan voimaan mahdollisimman pian, viimeistään syksyllä 2026.","org":"sosiaali- ja terveysministeriö","person":"Eeva Vartio","read":true,"stance":"esittely","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-44779"}]},"id":"fi-he-124-2026","kierros":{"kannat":{"ei":4},"luettu":4,"n":19,"rivit":[{"date":"2026-06-07","org":"Pohjois-Karjalan Työttömät ry","url":"https://api.hankeikkuna.fi/asiakirjat/738f384d-de8c-4dcf-8901-84f41f17f265/65063983-8df9-4125-ae12-d488a7aaa856/LAUSUNTO_20260608170735.PDF"},{"date":"2026-06-05","org":"Eläkeläisliittojen etujärjestö EETU ry","url":"https://api.hankeikkuna.fi/asiakirjat/738f384d-de8c-4dcf-8901-84f41f17f265/8a85f651-3b05-40bf-83dd-f7e3523c5645/LAUSUNTO_20260607042423.PDF"},{"date":"2026-06-05","org":"Suomen Amma