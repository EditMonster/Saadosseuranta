{"eduskunta":{"kannat":{"esittely":3,"kannattaa":3,"kanta":1,"muutoksia":2,"varauksin":4},"luettu":13,"n":13,"rivit":[{"committee":"HaV","date":"2026-09-30","gist":"Sosiaali- ja terveysministeriö pitää perusteltuna sitä, että erityisesti opiskelijasta riippumattomista ja painavista syistä johtuva tilapäinen perustoimeentulotuen käyttö voidaan ottaa lupaharkinnassa huomioon hyväksyttävänä seikkana.","org":"sosiaali- ja terveysministeriö","read":true,"stance":"varauksin","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-48367"},{"committee":"HaV","date":"2026-09-30","gist":"Toisin sanoen henkilökohtaiset painavat syyt voisivat peruuttamisharkinnassa puoltaa luvan perumatta jättämistä. Tämän osalta kuitenkin ehdotettu lainkohta ei sanamuodon mukaan antaisi tähän mahdollisuutta.","org":"Poliisihallitus","read":true,"stance":"varauksin","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-48865"},{"committee":"HaV","date":"2026-09-30","gist":"Arene pitää tärkeänä, ettei tilapäinen tai opiskelijasta riippumattomasta syystä syntynyt toimeentulotuen tarve yksin johda luvan menettämiseen silloin, kun 12 §:n 4 momentin mukainen kokonaisarvio puoltaa luvan säilymistä.","org":"Ammattikorkeakoulujen rehtorineuvosto Arene ry","read":true,"stance":"varauksin","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-48868"},{"committee":"HaV","date":"2026-09-30","gist":"SYL pitää kuitenkin myönteisenä sitä, että hallitus on kuullut lausuntokierroksella esitettyä laajaa huolta perus- ja ihmisoikeuksista ja tehnyt esitykseen korjauksia.","org":"Suomen ylioppilaskuntien liitto SYL ry","read":true,"stance":"varauksin","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-48869"},{"committee":"HaV","date":"2026-09-30","gist":"Unifi pitää tärkeänä, että opiskelijoilla on Suomeen saapuessaan käytettävissään selkeä ja realistinen tieto siitä, mitkä ovat Suomessa oleskelun, opiskelun ja työnteon taloudelliset edellytykset.","org":"Suomen yliopistojen rehtorineuvosto UNIFI ry","person":"Heidi Rättyä","read":true,"stance":"muutoksia","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-48860"},{"committee":"HaV","date":"2026-09-30","gist":"SAMOK on äärimmäisen huolissaan esityksen inhimillisistä vaikutuksista.","org":"Suomen opiskelijakuntien liitto - SAMOK ry","person":"Jere Tapio","read":true,"stance":"muutoksia","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-48925"},{"committee":"HaV","date":"2026-09-30","gist":"Laillinen oleskelu ja oleskelulupaedellytys Kolmannen maan kansalaisen oikeus Kelan etuuksiin edellyttää laillista Suomessa oleskelua, mikä tarkoittaa kolmannen maan kansalaiselle vaatimusta voimassa olevasta oleskeluluvasta.","org":"Kansaneläkelaitos","person":"Antti Klemola","read":true,"stance":"kannattaa","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-48503"},{"committee":"HaV","date":"2026-09-30","gist":"Maahanmuuttovirasto kannattaa ehdotettuja lakimuutoksia, koska katsoo niiden selkeyttävän opiskelijan oleskeluluvan uusimista ja peruuttamista koskevaa harkintaa.","org":"Maahanmuuttovirasto","person":"Siiri Veijonen","read":true,"stance":"kannattaa","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-48859"},{"committee":"HaV","date":"2026-09-30","gist":"SLL näkee positiivisena myös sen, että hallituksen esityksen perusteluihin on kirjattu lausuntopalautteen perusteella tilanteita, joissa lupaa ei tulisi peruuttaa, kuten lapsen erityinen tuen tarve, sairauden hoidon yllättävät kulut, rikoksen tai ihmiskaupan uhriksi joutuminen …","org":"Suomen Lukiolaisten Liitto ry","read":true,"stance":"kannattaa","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-48872"},{"committee":"HaV","date":"2026-09-30","gist":"Oikeusministeriö on lausunut nyt käsiteltävänä olevasta esityksestä valmisteluvaiheessa, ja oikeusministeriön kommentit on otettu asianmukaisesti jatkovalmistelussa huomioon.","org":"oikeusministeriö","read":true,"stance":"kanta","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-48864"},{"committee":"HaV","date":"2026-09-30","gist":"Esitys tukee myös periaatetta, jonka mukaan opiskeluperusteinen maahanmuutto perustuu omaan toimeentuloon eikä viimesijaisen sosiaaliturvan varaan.","org":"työ- ja elinkeinoministeriö","person":"Jarmo Tiukkanen","read":true,"stance":"esittely","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-48366"},{"committee":"HaV","date":"2026-09-30","gist":"Sisäministeriö katsoo, että poikkeuksesta oleskeluluvan peruuttamiseen tai uusimatta jättämiseen tulisi tarvittaessa säätää nimenomaisesti.","org":"sisäministeriö","person":"Tuuli Tuunanen","read":true,"stance":"esittely","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-48854"},{"committee":"HaV","date":"2026-09-30","gist":"Opetus- ja kulttuuriministeriö toteaa, että ehdotettavalla muutoksella ei aseteta uusia vaatimuksia opiskelijoille.","org":"opetus- ja kulttuuriministeriö","person":"Anna Kankaanpää","read":true,"stance":"esittely","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-48857"}]},"id":"fi-he-79-2026","kierros":{"kannat":{"ei":2},"luettu":2,"n":56,"rivit":[{"date":"2026-02-27","org":"Oikeusministeriö","url":"https://api.hankeikkuna.fi/asiakirjat/7efe4f02-719c-4f93-9d09-cbae3319e687/13a0f0f0-654c-4870-8c34-bb5de7f856e7/LAUSUNTO_20260227114657.PDF"},{"date":"2026-02-27","org":"Opetus- ja kulttuuriministeriö","url":"https://api.hankeikkuna.fi/asiakirjat/7efe4f02-719c-4f93-9d09-cbae3319e687/4030f478-b856-46a5-a705-5f37a8ca83f0/LAUSUNTO_20260227114854.PDF"},{"date":"2026-02-27","org":"Jyväskylän yliopisto","url":"https://api.hankeikkuna.fi/asiakirjat/7efe4f02-719c-4f93-9d09-cbae3319e687/0cb7de3d-3e43-436b-a5c9-bfbc456ab330/LAUSUNTO_20260302194623.PDF"},{"date":"2026-02-27","org":"STTK ry","url":"https://api.hankeikkuna.fi/asiakirjat/7efe4f02-719c-4f93-9d09-cbae3319e687/0c943c06-9201-4e2d-8624-f171ffd7ff6a/LAUSUNTO_20260302194835.PDF"},{"date":"2026-02-27","org":"Turun yliopiston ylioppilaskunta","url":"https://api.hankeikkuna.fi/asiakirjat/7efe4f02-719c-4f93-9d09-cbae3319e687/dd51533f-5867-46f5-9dd0-d250614c7891/LAUSUNTO_20260302195046.PDF"},{"date":"2026-02