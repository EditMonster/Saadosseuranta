EDK-2026-AK-48354"},{"committee":"HaV","date":"2026-09-29","gist":"Rahanpesuasetuksessa vahvistetaan säännöt, joita ilmoitusvelvollisten on toteutettava rahanpesun ja terrorismin rahoituksen estämiseksi sekä oikeushenkilöille, express trust -järjestelyille ja vastaaville oikeudellisille järjestelyille asetettavat tosiasiallisen omistajuuden ja …","org":"valtiovarainministeriö","person":"Elina Rantakokko","read":true,"stance":"esittely","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-48493"},{"committee":"HaV","date":"2026-09-29","gist":"Poliisiosasto katsoo, että sääntelyjen rinnakkainen soveltaminen edellyttää niiden keskinäisen suhteen täsmentämistä.","org":"sisäministeriö","person":"Juha Tuovinen","read":true,"stance":"esittely","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-48528"},{"committee":"PeV","date":"2026-09-09","gist":"Rahanpesulainsäädännön kokonaisuudistus HE 105 / 2026 vp LAINSÄÄDÄNTÖNEUVOS NINA SANTAHARJU PERUSTUSLAKIVALIOKUNTA 9.9.2026 ESITYKSEN SISÄLTÖ • EU-sääntely ja HE:n keskeinen sisältö • Suhde perustuslakiin ja säätämisjärjestys:","org":"valtiovarainministeriö","person":"Nina Santaharju","read":true,"stance":"esittely","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-41583"}]},"id":"fi-he-105-2026","kierros":{"kannat":{"ei":3},"luettu":2,"n":59,"rivit":[{"date":"2025-10-29","org":"Ålands landskapsregering","url":"https://api.hankeikkuna.fi/asiakirjat/cda5396f-ca2a-4e61-bc56-14f557d82fe2/e42eaa4c-4817-48a6-b558-e4bd4cc25e90/LAUSUNTO_20251029112632.PDF"},{"date":"2025-09-05","org":"Tietosuojavaltuutetun toimisto","url":"https://api.hankeikkuna.fi/asiakirjat/cda5396f-ca2a-4e61-bc56-14f557d82fe2/7ab5684d-63cb-4eae-b219-dc4214f703fc/LAUSUNTO_20250908114907.PDF"},{"date":"2025-08-29","org":"Veikkaus Oy","url":"https://api.hankeikkuna.fi/asiakirjat/cda5396f-ca2a-4e61-bc56-14f557d82fe2/188f96d9-a1bb-4d5f-a114-8afe895c2a8f/LAUSUNTO_20250829110259.PDF"},{"date":"2025-08-29","org":"Suomen Yrittäjät ry","url":"https://api.hankeikkuna.fi/asiakirjat/cda53