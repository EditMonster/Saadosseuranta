kunta.fi/pdf/EDK-2025-AK-42654"},{"committee":"VeJ","date":"2025-10-07","org":"Suomen Yrittäjät ry","url":"https://www.eduskunta.fi/pdf/EDK-2025-AK-42714"},{"committee":"VeJ","date":"2025-10-07","org":"Elinkeinoelämän keskusliitto ry","person":"Penna Urrila","url":"https://www.eduskunta.fi/pdf/EDK-2025-AK-42767"},{"committee":"VeJ","date":"2025-09-23","org":"Verohallinto","person":"Mia Keskinen","url":"https://www.eduskunta.fi/pdf/EDK-2025-AK-37601"},{"committee":"VeJ","date":"2025-09-23","org":"valtiovarainministeriö","person":"Esa-Pekka Saari","url":"https://www.eduskunta.fi/pdf/EDK-2025-AK-37603"}]},"id":"fi-he-94-2025","kierros":{"kannat":{"ei":1,"kannattaa":4,"kanta":1,"muutoksia":5,"varauksin":6,"vastustaa":1},"luettu":18,"n":18,"rivit":[{"date":"2025-08-21","gist":"En pidä hyvänä sitä, jos viivästyskorko painetaan niin alas, että veroa ei kannata maksaa ajoissa ja valtio muodostuu laajasti edullisimmaksi luotonantajaksi.","org":"Senior Fellow Timo Viherkentän lausunto","read":true,"stance":"vastustaa","url":"https://api.hankeikkuna.fi/asiakirjat/f14a4bd4-507c-49e5-ae51-796ab22badd9/19f8004a-8e5f-4d58-b01a-30c1fd4efd4f/LAUSUNTO_20250822064813.PDF"},{"date":"2025-08-21","gist":"Sukupolvenvaihdoshuojennusta ei voida pitää perusteltuna verojärjestelmän osana.","org":"Suomen Ammattiliittojen Keskusjärjestö SAK ry","read":true,"stance":"varauksin","url":"https://api.hankeikkuna.fi/asiakirjat/f14a4bd4-507c-49e5-ae51-796ab22badd9/bedea0dc-3ed4-4476-b7dd-006456a2cb36/LAUSUNTO_20250821170833.PDF"},{"date":"2025-08-21","gist":"Nykyinen oikeustila perustuu ratkaisuun KHO 2015:166 ja sen muuttamista lainsäädännöllä voidaan pitää perusteltuna ja tarpeellisena.","org":"Yliopistonlehtori Matti Urpilaisen lausunto","read":true,"stance":"varauksin","url":"https://api.hankeikkuna.fi/asiakirjat/f14a4bd4-507c-49e5-ae51-796ab22badd9/198dd062-61dd-4c19-ab31-991cdab41c85/LAUSUNTO_20250822080134.PDF"},{"date":"2025-08-21","gist":"Yleisarvio Veronmaksajain Keskusliitto kannattaa esitettyjä muutoksia perintö- ja lahjaverotukseen.","org":"Veronmaksajain Keskusliitto ry","read":true,"stance":"varauksin","url":"https://api.hankeikkuna.fi/asiakirjat/f14a4bd4-507c-49e5-ae51-796ab22badd9/74c8df6a-45b3-45cc-a6e4-881e4a943b7b/LAUSUNTO_20250824030037.PDF"},{"date":"2025-08-21","gist":"Sitä voidaan pitää kaikilta osin perusteltuna ja kannatettavana.","org":"Professori Juha Lindgrenin lausunto","read":true,"stance":"varauksin","url":"https://api.hankeikkuna.fi/asiakirjat/f14a4bd4-507c-49e5-ae51-796ab22badd9/ef62a48d-493b-4648-8b43-5e84ff22f8fc/LAUSUNTO_20250922065750.PDF"},{"date":"2025-08-19","gist":"Perheyritysten liitto kannattaa esitysluonnokseen sisältyvää muutosta, jonka mukaan myös alaikäinen voi saada sukupolvenvaihdoshuojennuksen perintöverosta, jos hänen puolestaan yritystoiminta jatkaa edunvalvoja.","org":"Perheyritysten liitto ry","read":true,"stance":"varauksin","url":"https://api.hankeikkuna.fi/asiakirjat/f14a4bd4-507c-49e5-ae51-796ab22badd9/2a433edf-95bb-461d-a3e6-cf81fb19ddd1/LAUSUNTO_20250819181716.PDF"},{"date":"2025-07-02","gist":"Tosin lahjoituksiin liittyy esitysluonnoksessakin todettuja eroja suhteessa perintötilanteisiin, jotka ainakin osin puoltavat muutoksen rajaamista vain perinnöksi saatuihin osakkeisiin.","org":"Vero-oikeuden professorin Pekka Nykäsen lausunto","read":true,"stance":"varauksin","url":"https://api.hankeikkuna.fi/asiakirjat/f14a4bd4-507c-49e5-ae51-796ab22badd9/b399b9f3-b40b-41c5-b2ea-d6a551e24e28/LAUSUNTO_20250826115258.PDF"},{"date":"2025-08-21","gist":"Ehdotus perintöverotuksen alarajan korottamisesta 20 000 eurosta 30 000 euroon ja lahjaverotuksen alarajan korottamisesta 5 000 eurosta 7 500 euroon on kannatettavaa, koska se keventää erityisesti pienempiä perintöjä ja lahjoja saavien verotusta ja voi siten vahvistaa …","org":"STTK ry","read":true,"stance":"muutoksia","url":"https://api.hankeikkuna.fi/asiakirjat/f14a4bd4-507c-49e5-ae51-796ab22badd9/618f1a49-97c7-44a2-a7c2-0d61486c6351/LAUSUNTO_20250821165346.PDF"},{"date":"2025-08-21","gist":"Sukupolvenvaihdoshuojennuksen osalta muutos poistaa oikeuskäytännön nojalla muodostuneen oikeustilanteen, jossa osakeyhtiömuotoisen yrityksen osakkeita saaneelle alaikäiselle perilliselle ei voida myöntää sukupolvenvaihdoshuojennusta.","org":"Mikro- ja yksinyrittäjät ry","read":true,"stance":"muutoksia","url":"https://api.hankeikkuna.fi/asiakirjat/f14a4bd4-507c-49e5-ae51-796ab22badd9/67936fdf-28a4-4e14-bd3c-ee7f95873886/LAUSUNTO_20250821165603.PDF"},{"date":"2025-08-21","gist":"Tiivistetysti katsomme, että ehdotetuista perintöveromuutoksista aiheutuva veronmenetys tulisi kompensoida korottamalla suurimpien perintöjen verotusta ja lahjaveron alarajakorotus jättää tekemättä.","org":"Finnwatch ry","read":true,"stance":"muutoksia","url":"https://api.hankeikkuna.fi/asiakirjat/f14a4bd4-507c-49e5-ae51-796ab22badd9/db87ad58-0884-4bac-8534-49586a0b3136/LAUSUNTO_20250821170105.PDF"},{"date":"2025-08-20","gist":"Hyvän verojärjestelmän taloustieteellisten periaatteiden mukaan veron maksu pitäisi perustua verovelvollisen maksukykyyn veron suorittamiseksi (ks. esim.","org":"Valtion taloudellinen tutkimuskeskus VATT","read":true,"stance":"muutoksia","url":"https://api.hankeikkuna.fi/asiakirjat/f14a4bd4-507c-49e5-ae51-796ab22badd9/6123b364-20fe-4d44-a7f9-f20a7baa6efd/LAUSUNTO_20250820175353.PDF"},{"date":"2025-08-08","gist":"Lisäksi hyvän verojärjestelmän tulisi olla mahdollisimman tehokas, eli kerätä verotuloja mahdollisimman vähin taloudellisen toiminnan vääristymin, sen tulisi jakaa verotaakkaa oikeudenmukaisesti talouden toimijoiden kesken sekä olla mahdollisimman yksinkertainen ja ennustettava.","org":"ETLA Elinkeinoelämän tutkimuslaitos","read":true,"stance":"muutoksia","url":"https://api.hankeikkuna.fi/asiakirjat/f14a4bd4-507c-49e5-ae51-796ab22badd9/76241fd4-1d11-4ce6-9b60-672f9c7c4333/LAUSUNTO_20250810021146.PDF"},{"date":"2025-08-21","gist":"Suomen Yrittäjät kannattaa esityksen tavoitteita kohentaa kotitalouksien ostovoimaa, vahvistaa talouskasvun edellytyksiä ja tukea kotimaista omistajuutta, ja pidämme ehdotuksia perusteltuina.","org":"Suomen Yrittäjät ry","read":true,"stance":"kannattaa","url":"https://api.hankeikkuna.fi/asiakirjat/f14a4bd4-507c-49e5-ae51-796ab22badd9/47966de2-eb69-4a14-b530-812183aaa314/LAUSUNTO_20250821171340.PDF"},{"date":"2025-08-21","gist":"Suomen Vuokranantajat kannattaa esitettyjä muutoksia perintö- ja lahjaverotukseen.","org":"Suomen Vuokranantajat ry","read":true,"stance":"kannattaa","url":"https://api.hankeikkuna.fi/asiakirjat/f14a4bd4-507c-49e5-ae51-796ab22badd9/60e3064c-868d-4c03-a8dd-841742f4a915/LAUSUNTO_20250821171559.PDF"},{"date":"2025-08-21","gist":"Säännöksessä edellytetyksi yritystoiminnan jatkamiseksi katsottaisiin myös alaikäisen perinnönsaajan edunvalvojan osakeyhtiössä jatkama yritystoiminta.","org":"Elinkeinoelämän keskusliitto EK","read":true,"stance":"kannattaa","url":"https://api.hankeikkuna.fi/asiakirjat/f14a4bd4-507c-49e5-ae51-796ab22badd9/c6798bfb-72e1-400a-a6ea-2071efb8c33a/LAUSUNTO_20250825072133.PDF"},{"date":"2025-08-20","gist":"Perintö- ja lahjaverotuksen tasoa tulisikin edelleen pyrkiä laskemaan sen yritystoiminnalle aiheuttavien haittojen lieventämiseksi, ja koko veron tarpeellisuuden arviointiakin tulisi jatkaa.","org":"Keskuskauppakamari ry","read":true,"stance":"kannattaa","url":"https://api.hankeikkuna.fi/asiakirjat/f14a4bd4-507c-49e5-ae51-796ab22badd9/a8e53a1e-b224-43b8-911e-7abebb11317c/LAUSUNTO_20250820174606.PDF"},{"date":"2025-08-21","gist":"Verohallinnolla ei ole muuta lausuttavaa esitysluonnoksesta.","org":"Verohallinto","read":true,"stance":"kanta","url":"https://api.hankeikkuna.fi/asiakirjat/f14a4bd4-507c-49e5-ae51-796ab22badd9/9ab959d2-f4f4-4ca9-a66d-0ab2449ed820/LAUSUNTO_20250824024804.PDF"},{"date":"2025-07-28","noFile":true,"org":"Työ- ja elinkeinoministeriö","read":true,"stance":"ei"}],"url":"https://www.lausuntopalvelu.fi/FI/Proposal/Participation?proposalId=e68cc2ea-02b0-493f-8916-2d90babf5c00"},"odottaa":18,"tiivistetty":18,"va