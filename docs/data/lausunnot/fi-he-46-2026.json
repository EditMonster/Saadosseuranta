{"eduskunta":{"kannat":{"kannattaa":3,"kanta":3,"muutoksia":4,"osin":2,"varauksin":8},"luettu":20,"n":21,"rivit":[{"committee":"LaV","date":"2026-09-10","gist":"YLEISTÄ Suomen Asianajajat kannattaa edelleen hallinnollisten seuraamusmaksujen soveltamisalan laajentamista koskemaan myös julkissektorin toimijoita.","org":"Suomen Asianajajat","person":"Johanna Lilja","read":true,"stance":"osin","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-42224"},{"committee":"LaV","date":"2026-04-28","gist":"YLEISTÄ Suomen Asianajajat kannattaa hallinnollisen seuraamusmaksun soveltamisalan laajentamista koskemaan myös julkisen sektorin toimijoita, ja pitää annettua hallituksen esitystä erittäin tervetulleena ja tasapainoisesti perusteltuna uudistuksena.","org":"Suomen Asianajajat","person":"Johanna Lilja","read":true,"stance":"osin","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-23185"},{"committee":"LaV","date":"2026-09-10","gist":"Syyttäjälaitos pitää perusteltuna, että viranomaisiin kohdistettavia hallinnollisia seuraamusmaksuja koskevat säännökset poistetaan lakiehdotuksesta perustuslakivaliokunnan edellyttämällä tavalla.","org":"Syyttäjälaitos","person":"Tommi Hietanen","read":true,"stance":"varauksin","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-42154"},{"committee":"LaV","date":"2026-09-10","gist":"Sisäministeriö kannattaa ja pitää perusteltuna oikeusministeriön ehdotusta, jonka mukaan rikoslain 40 luvun 9 ja 10 §:iä sovellettaisiin luvun 12 §:n 2 momentin estämättä myös julkisyhteisön työntekijään.","org":"sisäministeriö","read":true,"stance":"varauksin","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-42240"},{"committee":"LaV","date":"2026-09-10","gist":"2 Keskusrikospoliisin lausunto 2.1 Hallinnolliset seuraamusmaksut ja valvontamekanismit Keskusrikospoliisi pitää edelleen perusteltuna ratkaisua, jonka mukaan hallinnollisia seuraamusmaksuja ei määrättäisi viranomaisille, vaikka Keskusrikospoliisi tunnistaa, että kyseinen …","org":"keskusrikospoliisi","person":"Anna Haveri","read":true,"stance":"varauksin","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-42244"},{"committee":"LaV","date":"2026-09-10","gist":"Pidämme esitettyjä muutoksia tarpeellisena järjestelmän selkiyttämiseksi ja yhdenvertaisuuden ja oikeudenmukaisuuden edistämiseksi.","org":"tietosuojavaltuutetun toimisto","person":"Anu Talus","read":true,"stance":"varauksin","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-42246"},{"committee":"LaV","date":"2026-04-28","gist":"Koska yleinen tietosuoja-asetus edellyttää säädettäväksi hallinnollisten sakkojen määräämisen perusteista, rikoslain 9 luvun mukaisen yhteisösakon tuomitsemista rikosasian oikeudenkäynnissä ei voida pitää asetuksen edellyttämänä hallinnollisena rangaistusseuraamuksena.","org":"Olli Mäenpää","person":"Olli Mäenpää","read":true,"stance":"varauksin","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-23092"},{"committee":"LaV","date":"2026-04-28","gist":"4 Valiokunta on katsonut, että siltä osin kuin EU:n lainsäädäntö edellyttää kansallista sääntelyä tai mahdollistaa sen, tätä kansallista liikkumavaraa käytettäessä on otettava huomioon perus- ja ihmisoikeuksista seuraavat vaatimukset (esim.","org":"Sakari Melander","person":"Sakari Melander","read":true,"stance":"varauksin","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-23125"},{"committee":"LaV","date":"2026-04-28","gist":"Katsomme, että ehdotettu sääntelyratkaisu osaltaan tukee tehokasta, sujuvaa ja ennakoitavaa valvontatoimintaa.","org":"tietosuojavaltuutetun toimisto","person":"Anu Talus","read":true,"stance":"varauksin","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-23159"},{"committee":"LaV","date":"2026-04-28","gist":"Seuraamusmaksun määräämistä julkissektorille ei voida pitää kannatettavana.","org":"Oikeusrekisterikeskus","read":true,"stance":"varauksin","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-23161"},{"committee":"LaV","date":"2026-09-10","gist":"Oikeusministeriö esittää, että hallituksen esityksessä esitellyt hallinnolliset seuraamusmaksut poistettaisiin julkishallinnon organisaatioilta.","org":"Tuomioistuinvirasto","person":"Inka Grönqvist","read":true,"stance":"muutoksia","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-42167"},{"committee":"LaV","date":"2026-09-10","gist":"Koska ministeriön vastineessa ei ole lähemmin tarkasteltu niitä edellytyksiä, joita virkarikosoikeudellinen vastuu käytännössä edellyttää, katson aiheelliseksi käydä ensin läpi seikkoja, joiden varaan rikosoikeudellinen virkavastuu tietosuojakysymyksissä rakentuu.","org":"eduskunnan oikeusasiamiehen kanslia","read":true,"stance":"muutoksia","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-42218"},{"committee":"LaV","date":"2026-09-10","gist":"Perustuslakivaliokunnan lausunnossa todetun mukaan käsiteltävänä olevan esityksen arviointitilanne ei poikkea siinä määrin aiemmista, viranomaisille määrättävien seuraamusmaksujen mahdollisuutta koskevista arviointitilanteista, eikä sääntelylle ole esitetty sellaisia riittäviä …","org":"Sakari Melander","person":"Sakari Melander","read":true,"stance":"muutoksia","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-42235"},{"committee":"LaV","date":"2026-04-28","gist":"Sen vuoksi katson aiheelliseksi lausunnossani pääasiassa toistaa jo oikeusasiamies Jääskeläisen lausunnoissa esitettyjä kannanottoja.","org":"eduskunnan oikeusasiamiehen kanslia","person":"Jarmo Hirvonen","read":true,"stance":"muutoksia","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-23245"},{"committee":"LaV","date":"2026-09-10","gist":"4 Seuraamusmaksun vanhentuminen Oikeusministeriö katsoo, että 24 §:n 5 momentin muuttamista koskeva säännös tulisi säilyttää 1. lakiehdotuksessa.","org":"Olli Mäenpää","person":"Olli Mäenpää","read":true,"stance":"kannattaa","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-43471"},{"committee":"LaV","date":"2026-04-28","gist":"Helsingin hallinto-oikeus pitää rajausta perusteltuna tuomioistuinten riippumattomuuden varmistamiseksi.","org":"Helsingin hallinto-oikeus","person":"Liisa Selvenius-Hurme","read":true,"stance":"kannattaa","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-23172"},{"committee":"LaV","date":"2026-04-28","gist":"Helsingin hallinto-oikeus pitää rajausta perusteltuna tuomioistuinten riippumattomuuden varmistamiseksi.","org":"Helsingin hallinto-oikeus","person":"Liisa Selvenius-Hurme","read":true,"stance":"kannattaa","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-23176"},{"committee":"LaV","date":"2026-09-10","gist":"Käräjäoikeus katsoo oikeusministeriön vastineessa esitettyjen tietosuojalain 26 § ja rikosasioiden tietosuojalain 61 §:n rangaistussäännöksiä koskevien muutosehdotuksien olevan tarpeellisia ja perusteltuja (s.","org":"Helsingin käräjäoikeus","read":true,"stance":"kanta","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-42251"},{"committee":"LaV","date":"2026-04-28","gist":"Lainvoimaisuustodistuksien/-tietojen antaminen ei toki työllistä yhtä paljon kuin itse valitusasian käsittely, mutta sekin tulisi huomioida, kun arvioidaan vaikutuksia ja lisätyön määrää tuomioistuimille.","org":"Tuomioistuinvirasto","person":"Sini Takaneva","read":true,"stance":"kanta","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-23145"},{"committee":"LaV","date":"2026-04-28","gist":"Syyttäjälaitos katsoo, että lakiehdotukseen annettu lausuntopalaute tulisi huomioida lain valmistelussa paremmin.","org":"Syyttäjälaitos","person":"Tommi Hietanen","read":true,"stance":"kanta","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-23162"},{"committee":"LaV","date":"2026-04-28","org":"oikeusministeriö","person":"Virpi Koivu","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-23058"}]},"id":"fi-he-46-2026","kierros":{"kannat":{"ei":4},"luettu":0,"n":173,"rivit":[{"date":"2025-11-14","org":"Suomen Akatemia","url":"https://api.hankeikkuna.fi/asiakirjat/02f9a2c5-0bff-4f65-9f20-16649b7c4daf/496adacb-b0a0-402e-8117-0eb3759e9627/LAUSUNTO_20251117054937.PDF"},{"date":"2025-11-14","org":"Valtioneuvoston kanslia","url":"https://api.hankeikkuna.fi/asiakirjat/02f9a2c5-0bff-4f65-9f20-16649b7c4