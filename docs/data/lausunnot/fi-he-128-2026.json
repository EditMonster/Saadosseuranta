{"eduskunta":{"kannat":{"kannattaa":2,"kanta":2,"muutoksia":1,"varauksin":4},"luettu":9,"n":10,"rivit":[{"committee":"TaV","date":"2026-09-16","gist":"Patentti- ja rekisterihallitus kannattaa hallituksen esitykseen sisältyviä muutosehdotuksia. Patentti- ja rekisterihallitus kannattaa erityisesti ehdotusta nostaa hyödyllisyysmallilta edellytetty keksinnöllisyystaso samaksi kuin patenteilla.","org":"Patentti- ja rekisterihallitus","person":"Hanna Aho","read":true,"stance":"varauksin","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-43560"},{"committee":"TaV","date":"2026-09-16","gist":"Hyödyllisyysmallin säilyttäminen ja modernisointi on tarpeen Suomen Yrittäjät pitää esitystä tärkeänä ja tarpeellisena.","org":"Suomen Yrittäjät ry","person":"Albert Mäkelä","read":true,"stance":"varauksin","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-43811"},{"committee":"TaV","date":"2026-09-16","gist":"EK pitää nyt ehdotettuja täydennyksiä hyvinä ja perusteltuina, mutta kannustaa jatkoselvittämään myös arvioitua mahdollisuutta uudistaa hyödyllisyysmallin mitätöintimenettelyä erityisesti siten, että hyödyllisyysmallin rekisteröinnin mitättömäksi julistamista voisi vaatia …","org":"Elinkeinoelämän keskusliitto ry","person":"Hannu Ylänen","read":true,"stance":"varauksin","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-43813"},{"committee":"TaV","date":"2026-09-16","gist":"Suomen AIPPI ei yhdy markkinaoikeuden ja Business Finlandin lausuntokierroksella esittämään näkemykseen järjestelmästä luopumisesta, vaan kannattaa esityksen lähtökohtaa kehittää järjestelmää sen säilyttämiseksi.","org":"Suomen AIPPI ry","read":true,"stance":"varauksin","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-43816"},{"committee":"TaV","date":"2026-09-16","gist":"Hallituksen esityksessä esitetyt muutokset, joilla hyödyllisyysmalleja koskevia vaatimuksia yhdenmukaistetaan patentteja koskevien säännösten kanssa, ovat perusteltuja.","org":"University Center","person":"University Center","read":true,"stance":"muutoksia","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-43815"},{"committee":"TaV","date":"2026-09-16","gist":"Suomen Patenttiasiamiesyhdistys ry (jäljempänä ”SPAY”) esittää lausuntonsa seuraavassa.","org":"Suomen Patenttiasiamiesyhdistys ry","person":"Jarkko Tiilikainen","read":true,"stance":"kannattaa","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-43812"},{"committee":"TaV","date":"2026-09-16","gist":"STY pitää tärkeänä, että tämä suojamuoto säilyy osana suomalaista keksintöjen suojajärjestelmää, ja kannattaa siksi esityksen lähtökohtaa kehittää järjestelmää sen kumoamisen sijaan.","org":"Suomen teollisoikeudellinen yhdistys r.y.","read":true,"stance":"kannattaa","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-43817"},{"committee":"TaV","date":"2026-09-16","gist":"Hyödyllisyysmallilla on mahdollista suojata innovaatio ilman pitkää ja vaativaa viranomaisprosessia, sillä se tarjoaa nopean suojan ilman kattavaa ennakkotutkimusta.","org":"Keskuskauppakamari","person":"Minna Aalto-Setälä","read":true,"stance":"kanta","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-43810"},{"committee":"TaV","date":"2026-09-16","gist":"Lausunnon mukaan 1) hyödyllisyysmallilain tulisi vastata kielellisesti ja käsitteellisesti patenttilakia, 2) yksinoikeuden rajoitussäännös on poikkeuksellinen, 3) tuomioistuinmenettelyä tulisi sujuvoittaa ja 4) on kysytty, onko hyödyllisyysmallijärjestelmä edelleen perusteltu.","org":"markkinaoikeus","read":true,"stance":"kanta","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-43818"},{"committee":"TaV","date":"2026-09-16","org":"työ- ja elinkeinoministeriö","person":"Tanja Müller","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-43808"}]},"id":"fi-he-128-2026","kierros":{"kannat":{},"luettu":0,"n":17,"rivit":[{"date":"2026-05-21","org":"Puolustusministeriö","url":"https://api.hankeikkuna.fi/asiakirjat/d54fece0-91b3-45a6-8830-c23dbfbe2387/1472ff57-f701-4d21-af1f-d99283b2da6c/LAUSUNTO_20260521121444.PDF"},{"date":"2026-05-20","org":"Markkinaoikeus","url":"