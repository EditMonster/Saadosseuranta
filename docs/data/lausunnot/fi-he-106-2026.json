{"eduskunta":{"kannat":{"muutoksia":2,"varauksin":2},"luettu":4,"n":6,"rivit":[{"committee":"PeV","date":"2026-09-08","gist":"Vaikka säätämisjärjestysperusteluissa onkin jakso 10.3 Oikeusturva, hyvä hallinto ja lainalaisuus, jaksossa ei käytännössä lainkaan arvioida automaattisen neuvonnan suhdetta lakiperusteisuuteen tai lain noudattamisen vaatimukseen.","org":"Ida Koivisto","person":"Ida Koivisto","read":true,"stance":"varauksin","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-41363"},{"committee":"PeV","date":"2026-09-08","gist":"Tällaisia sisällöllisesti keskeisiä vaatimuksia sisältyy erityisesti hallintolain 2 lukuun, joka edellyttää etenkin hallinnon oikeusperiaatteiden, palveluperiaatteen ja hyvän kielenkäytön vaatimusten noudattamista myös neuvonnassa.","org":"Olli Mäenpää","person":"Olli Mäenpää","read":true,"stance":"varauksin","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-41463"},{"committee":"PeV","date":"2026-09-08","gist":"Tekoälyasetuksessa on säädetty vaatimuksia tällaisille tekoälyjärjestelmille, mutta näitä vaatimuksia ei sovelleta, jos automaattinen neuvonta ei kuulu unionin oikeuden piiriin.","org":"Tomi Voutilainen","person":"Tomi Voutilainen","read":true,"stance":"muutoksia","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-41361"},{"committee":"PeV","date":"2026-09-08","gist":"Viranomaisen olisi varmistettava ennen käyttöönottoa, että automaattinen neuvonta vastaa sille asettamia vaatimuksia.","org":"Tuomas Pöysti","person":"Tuomas Pöysti","read":true,"stance":"muutoksia","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-41464"},{"committee":"PeV","date":"2026-09-08","org":"oikeusministeriö","person":"Kari Hämäläinen","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-41462"},{"committee":"PeV","date":"2026-09-08","org":"valtiovarainministeriö","person":"Kaj Välimäki","url":"https://www.eduskunta.fi/pdf/EDK-2026-AK-41530"}]},"id":"fi-he-106-2026","kierros":{"kannat":{"ei":1},"luettu":0,"n":78,"rivit":[{"date":"2026-04-10","org":"Oikeusministeriö","